# FINX Environment Configuration Template
# Centralized B2B Milestone-Payment & Trust Infrastructure

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database (Local or Supabase)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

# Direct Datasource Connection (Set for Supabase with sslmode=require)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-project-id.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.your_project_ref
SPRING_DATASOURCE_PASSWORD=your_supabase_password

# Supabase Disaggregated Parameters (Alternative)
SUPABASE_DB_HOST=your-project-id.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_supabase_password

# Redis Configuration
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Security & JWT Tokens
JWT_SECRET=your_256bit_or_greater_secret_key_here
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback/google

# Optional Admin Bootstrap (Backend runtime only)
FINX_ADMIN_INITIAL_PASSWORD=your_initial_admin_password

# Banking Integration Configuration
# BANK_PROVIDER: 'mock' for local sandbox testing, or 'partner_name' for production licensed partner
BANK_PROVIDER=mock
BANK_DEFAULT_CURRENCY=INR
BANK_API_BASE_URL=https://api.bankingpartner.com/v1
BANK_CLIENT_ID=your_bank_client_id
BANK_CLIENT_SECRET=your_bank_client_secret
BANK_WEBHOOK_SECRET=your_bank_webhook_signature_secret_key

# Sandbox Mock Bank Options
BANK_MOCK_AUTO_SETTLE=false
BANK_MOCK_LATENCY_MS=50
